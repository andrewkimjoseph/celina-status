# Copy to `.env.local` (or `.env`) for local dev. Vite loads these for server functions.
# On Cloudflare, set the same names as Worker secrets (`wrangler secret put STATS_READ_KEY`).

# Optional. Defaults to the production stats API.
STATS_API_BASE_URL=https://api.stats.usecelina.xyz

# Same bearer token as STATS_READ_KEY on celina-stats-api.
# Required for on-chain, off-chain, and download stats. Live health checks do not use it.
STATS_READ_KEY=
